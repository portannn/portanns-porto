---
interface Props {
  title: string;
  flush?: boolean;
}

const { title, flush = false } = Astro.props;
---

<div class="border-fg-dim bg-bg/60 flex h-full flex-col border shadow-[0_0_18px_-6px_var(--color-fg-dim)]">
  <div class="border-fg-dim text-fg-dim flex items-center justify-between gap-3 border-b px-3 py-1.5 text-xs sm:text-sm">
    <span class="truncate">{title}</span>
    <span class="shrink-0 tracking-widest" aria-hidden="true">[_][&#9633;][x]</span>
  </div>
  <div class:list={['flex flex-1 flex-col gap-1', !flush && 'p-4 sm:p-6']}>
    <slot />
  </div>
</div>
