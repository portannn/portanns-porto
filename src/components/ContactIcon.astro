---
interface Props {
  name: 'email' | 'github' | 'linkedin';
}

const { name } = Astro.props;
---

{
  name === 'email' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="m3.5 6.5 8.5 7 8.5-7" />
    </svg>
  )
}
{
  name === 'github' && (
