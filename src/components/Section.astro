---
interface Props {
  id: string;
  command: string;
}

const { id, command } = Astro.props;
---

<section id={id} class="mx-auto flex min-h-dvh w-full max-w-3xl flex-col gap-6 px-4 py-24">
  <h2 class="font-heading text-fg text-glow text-3xl sm:text-4xl">
    <span class="text-fg-dim" aria-hidden="true">$</span> {command}
  </h2>
  <div class="text-fg-dim flex flex-col gap-4 text-sm sm:text-base">
    <slot />
  </div>
</section>
