---
import TerminalWindow from './TerminalWindow.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  url?: string;
  repo?: string;
}

const { title, description, tags, url, repo } = Astro.props;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<article class="h-full">
  <TerminalWindow title={`~/projects/${slug}`}>
    <h3 class="font-heading text-fg text-glow text-xl sm:text-2xl">
      <span class="text-fg-dim" aria-hidden="true">&gt; </span>{title}
    </h3>
    <p class="text-fg-dim mt-2 text-sm sm:text-base">{description}</p>

    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Technologies used">
      {
        tags.map((tag) => (
          <li class="border-fg-dim text-fg-dim border px-2 py-0.5 text-xs">{tag}</li>
        ))
      }
    </ul>

    {
      (url || repo) && (
        <div class="mt-auto flex gap-4 pt-4 text-sm">
          {url && (
            <a href={url} target="_blank" rel="noreferrer" class="text-fg hover:text-glow underline">
              live &rarr;
            </a>
          )}
          {repo && (
            <a href={repo} target="_blank" rel="noreferrer" class="text-fg hover:text-glow underline">
              github &rarr;
            </a>
          )}
        </div>
      )
    }
  </TerminalWindow>
</article>
