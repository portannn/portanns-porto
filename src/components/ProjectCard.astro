---
interface Props {
  title: string;
  description: string;
  tags: string[];
  url?: string;
  repo?: string;
}

const { title, description, tags, url, repo } = Astro.props;
---

<article class="border-fg-dim text-fg flex flex-col gap-3 border p-4 sm:p-5">
  <h3 class="font-heading text-fg text-xl sm:text-2xl">{title}</h3>
  <p class="text-fg-dim text-sm sm:text-base">{description}</p>

  <ul class="flex flex-wrap gap-2" aria-label="Technologies used">
    {
      tags.map((tag) => (
        <li class="border-fg-dim text-fg-dim border px-2 py-0.5 text-xs">{tag}</li>
      ))
    }
  </ul>

  {
    (url || repo) && (
      <div class="flex gap-4 text-sm">
        {url && (
          <a href={url} target="_blank" rel="noreferrer" class="text-fg hover:text-glow underline">
            live &rarr;
          </a>
        )}
        {repo && (
          <a href={repo} target="_blank" rel="noreferrer" class="text-fg hover:text-glow underline">
            github &rarr;
          </a>
        )}
      </div>
    )
  }
</article>
