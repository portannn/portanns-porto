---
import { site } from '../data/site';
import { asciiName } from '../data/ascii';
import ThemeToggle from './ThemeToggle.svelte';
import FaultyTerminal from './FaultyTerminal.svelte';
import DecryptedText from './DecryptedText.svelte';

const ascii = asciiName;
---

<section id="welcome" class="relative flex min-h-dvh flex-col items-center justify-center gap-8 overflow-hidden px-4 py-16 text-center">
  <div class="absolute inset-0 -z-20">
    <FaultyTerminal
      client:load
      brightness={0.22}
      glow={0.25}
      scanlineIntensity={0.15}
      vignette={0.6}
      curvature={0.05}
      mouseStrength={0.12}
    />
  </div>
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 60% 55% at center, var(--color-bg) 0%, color-mix(in srgb, var(--color-bg) 65%, transparent) 55%, transparent 85%);"
  >
  </div>
  <div class="absolute top-4 right-4">
    <ThemeToggle client:load />
  </div>
  <div role="img" aria-label={site.name} class="ascii-wrap text-fg text-glow relative inline-block">
    <pre class="ascii-anim select-none whitespace-pre font-heading text-[clamp(0.4rem,2.6vw,1.4rem)] leading-tight" aria-hidden="true">{ascii}</pre>
  </div>

  <p class="text-fg-dim text-base sm:text-lg">
    &gt; <DecryptedText client:load text={site.role} speed={30} sequential revealDirection="start" /><span
      class="cursor-blink">_</span
    >
  </p>

  <nav aria-label="Section navigation" class="flex flex-col gap-3 sm:flex-row sm:gap-4">
    {
      site.nav.map((item) => (
        <a
          href={item.href}
          class="border-fg text-fg hover:bg-fg hover:text-bg focus-visible:bg-fg focus-visible:text-bg block border px-5 py-2 text-base transition-colors"
        >
          [{item.key}] {item.label}
        </a>
      ))
    }
  </nav>

  <p class="text-fg-dim text-xs sm:text-sm">press 1-6 or click &middot; esc to return &middot; scroll &darr;</p>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ascii-anim {
      animation: ascii-flicker 6s infinite, ascii-glow 3s ease-in-out infinite;
    }
  }

  @keyframes ascii-flicker {
    0%,
    100% {
      opacity: 1;
    }
    92% {
      opacity: 1;
    }
    93% {
      opacity: 0.78;
    }
    94% {
      opacity: 1;
    }
    96% {
      opacity: 0.85;
    }
    97% {
      opacity: 1;
    }
  }

  @keyframes ascii-glow {
    0%,
    100% {
      text-shadow: 0 0 6px currentColor;
    }
    50% {
      text-shadow: 0 0 16px currentColor, 0 0 3px currentColor;
    }
  }
</style>
