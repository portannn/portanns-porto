---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Welcome from '../components/Welcome.astro';
import Section from '../components/Section.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.svelte';
import TerminalWindow from '../components/TerminalWindow.astro';
import ContactIcon from '../components/ContactIcon.astro';
import Portrait from '../components/Portrait.astro';
import KeyboardNav from '../components/KeyboardNav.svelte';
import StickyBar from '../components/StickyBar.svelte';
import { site } from '../data/site';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <main>
    <KeyboardNav client:load items={site.nav} />
    <StickyBar client:load items={site.nav} />
    <Welcome />

    <Section id="about" command="cat about.txt">
      <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start sm:gap-8">
        <div class="shrink-0">
          <TerminalWindow title="~/me.jpg" flush>
            <Portrait src="/me.webp" alt="Formal portrait of Triztan" />
          </TerminalWindow>
          <ul class="mt-3 flex w-0 min-w-full flex-wrap justify-center gap-x-1 gap-y-1" aria-label="Social links">
            {
              site.socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target={social.href.startsWith('http') ? '_blank' : undefined}
                    rel="noreferrer"
                    aria-label={social.label}
                    title={social.label}
                    class="text-fg-dim hover:text-fg hover:text-glow focus-visible:text-fg flex size-11 items-center justify-center transition-colors"
                  >
                    <ContactIcon name={social.name} class="size-7" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex flex-col gap-4 self-stretch">
          {site.about.map((line) => <p>{line}</p>)}
          <a
            href={site.links.cv}
            download
            class="border-fg text-fg hover:bg-fg hover:text-bg focus-visible:bg-fg focus-visible:text-bg mt-2 inline-flex w-fit items-center gap-2 border px-4 py-2 text-sm transition-colors"
          >
            <span aria-hidden="true">$</span> ./download-cv.pdf
          </a>
        </div>
      </div>
    </Section>

    <Section id="projects" command="ls projects/">
      {
        projects.length > 0 ? (
          <ProjectsShowcase
            client:load
            projects={projects.map((project) => ({
              slug: project.id,
              title: project.data.title,
              shortTitle: project.data.shortTitle ?? project.data.title,
              description: project.data.description,
              tags: project.data.tags,
              url: project.data.url,
              repo: project.data.repo,
              images: project.data.images ?? [],
              detailHtml: project.rendered?.html ?? ''
            }))}
          />
        ) : (
          <p>no projects published yet &mdash; check back soon.</p>
        )
      }
    </Section>

    <Section id="experience" command="git log --experience">
      <div class="flex flex-col gap-8">
        {
          site.experience.map((exp) => (
            <TerminalWindow title={`~/experience/${(exp.org || exp.role).toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
              <h3 class="font-heading text-fg text-glow text-xl sm:text-2xl">
                <span class="text-fg-dim" aria-hidden="true">
                  &gt;{' '}
                </span>
                {exp.role}
                {exp.org && <span class="text-fg-dim"> @ {exp.org}</span>}
              </h3>
              {(exp.period || exp.location) && (
                <p class="mt-2">{[exp.period, exp.location].filter(Boolean).join(' · ')}</p>
              )}
              <ul class="mt-3 flex list-none flex-col gap-2">
                {exp.points.map((point) => (
                  <li>
                    <span class="text-fg" aria-hidden="true">
                      $
                    </span>{' '}
                    {point}
                  </li>
                ))}
              </ul>
            </TerminalWindow>
          ))
        }
      </div>
    </Section>

    <Section id="education" command="cat education.txt">
      <div class="flex flex-col gap-8">
        {
          site.education.map((edu) => (
            <TerminalWindow title={`~/education/${edu.school.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
              <h3 class="font-heading text-fg text-glow text-xl sm:text-2xl">
                <span class="text-fg-dim" aria-hidden="true">
                  &gt;{' '}
                </span>
                {edu.school}
                {edu.location && <span class="text-fg-dim text-base sm:text-lg"> &mdash; {edu.location}</span>}
              </h3>
              <p class="mt-2">{edu.degree}</p>
              {edu.detail && <p>{edu.detail}</p>}
              {edu.period && <p>{edu.period}</p>}
              {edu.description && <p class="mt-3">{edu.description}</p>}
            </TerminalWindow>
          ))
        }
      </div>
    </Section>

    <Section id="skills" command="skills --list">
      <TerminalWindow title="~/skills">
        <div class="grid gap-x-10 gap-y-6 lg:grid-cols-2">
          {
            site.skills.map((group) => (
              <div>
                <p class="text-fg font-bold">{group.group}/</p>
                <ul class="mt-1">
                  {group.items.map((item, i) => (
                    <li class="pl-[4ch] -indent-[4ch]">
                      <span aria-hidden="true" class="text-fg-dim">{i === group.items.length - 1 ? '└── ' : '├── '}</span>
                      <span>{item.name}</span>
                      {item.projects.length > 0 && (
                        <span class="text-fg-dim text-xs sm:text-sm">
                          {' '}<span aria-hidden="true">&rarr; </span>
                          {item.projects.map((id, j) => (
                            <>
                              {j > 0 && ', '}
                              <a href="#projects" data-project={id} class="hover:text-fg whitespace-nowrap underline">
                                {site.projectLabels[id] ?? id}
                              </a>
                            </>
                          ))}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="border-fg-dim mt-8 grid gap-x-10 gap-y-6 border-t pt-6 lg:grid-cols-2">
          <div>
            <p class="text-fg font-bold">certifications/</p>
            <ul class="mt-1">
              {
                site.certifications.map((cert, i) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-fg-dim shrink-0">
                      {i === site.certifications.length - 1 ? '└──' : '├──'}
                    </span>
                    <span>{cert}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <p class="text-fg font-bold">languages/</p>
            <ul class="mt-1">
              {
                site.languages.map((lang, i) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-fg-dim">
                      {i === site.languages.length - 1 ? '└──' : '├──'}
                    </span>
                    <span>{lang}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </TerminalWindow>
    </Section>

    <Section id="contact" command="contact">
      <TerminalWindow title="~/contact">
      <ul class="flex flex-col gap-3">
        <li class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-3">
          <span class="text-fg-dim flex w-32 items-center gap-2"><ContactIcon name="email" />email:</span>
          <a href={`mailto:${site.links.email}`} class="text-fg hover:text-glow min-w-0 break-all underline">
            {site.links.email}
          </a>
        </li>
        <li class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-3">
          <span class="text-fg-dim flex w-32 items-center gap-2"><ContactIcon name="github" />github:</span>
          <a href={site.links.github} target="_blank" rel="noreferrer" class="text-fg hover:text-glow min-w-0 break-all underline">
            {site.links.github}
          </a>
        </li>
        <li class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-3">
          <span class="text-fg-dim flex w-32 items-center gap-2"><ContactIcon name="linkedin" />linkedin:</span>
          <a href={site.links.linkedin} target="_blank" rel="noreferrer" class="text-fg hover:text-glow min-w-0 break-all underline">
            {site.links.linkedin}
          </a>
        </li>
      </ul>
      </TerminalWindow>
    </Section>
  </main>
</Base>

<script>
  // a skill's project link asks the projects showcase to open that project
  document.querySelectorAll<HTMLAnchorElement>('a[data-project]').forEach((link) => {
    link.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('show-project', { detail: link.dataset.project }));
    });
  });
</script>
